# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local scratch
.tmp_case_studies/
.enrich-progress.json
.classify-industry-progress.json
.clawhub-import-progress.json
.github-bulk-import-progress.json

# third-party raw data dumps (ephemeral, not source-controlled)
scripts/data/clawhub-skills-raw.json

# claude code worktrees
.claude/worktrees/

# basecamp credentials (local only)
.basecamp/
skills-lock.json

# playwright / e2e test artifacts
test-results/
playwright-report/

# demo walkthrough generator scratch (Y4M fake-camera inputs, raw recordings)
tmp/

# silent-backup MP4s from scripts/add-explainer-audio.mjs — regenerable by
# re-running Playwright, no reason to double repo weight
public/videos/*-silent.mp4

# large screenshot directories (local capture artifacts)
screenshots-linkedin-launch/
screenshots-notebooklm/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.production
.env.development
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
