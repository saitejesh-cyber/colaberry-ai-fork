# Colaberry AI — example environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# Variables prefixed NEXT_PUBLIC_* are exposed to the browser at build time.

# ---------------------------------------------------------------------------
# Site / CMS
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.colaberry.ai
NEXT_PUBLIC_CMS_URL=https://colaberry-ai-cms-prod-<hash>.run.app
NEXT_PUBLIC_CMS_CACHE_TTL_MS=60000
NEXT_PUBLIC_SHOW_PRIVATE=false

# Server-only Strapi credentials (used by SSR / API routes).
CMS_URL=
CMS_API_TOKEN=
STRAPI_URL=
STRAPI_TOKEN=

# Optional client-side CMS token (only when content is intentionally public).
NEXT_PUBLIC_CMS_API_TOKEN=

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Email delivery (transactional, e.g. /api/demo-request notifications)
# ---------------------------------------------------------------------------
# NEWSLETTER_PROVIDER: console | resend | sendgrid
NEWSLETTER_PROVIDER=console
NEWSLETTER_FROM_EMAIL=Colaberry AI <no-reply@colaberry.ai>
NEWSLETTER_REPLY_TO_EMAIL=info@colaberry.com
RESEND_API_KEY=
SENDGRID_API_KEY=
NEWSLETTER_API_TIMEOUT_MS=8000
NEWSLETTER_HASH_SALT=
NEWSLETTER_UNSUBSCRIBE_SECRET=
NEWSLETTER_REPORT_API_KEY=
NEWSLETTER_REPORT_MAX_ROWS=1000
NEWSLETTER_SEND_DEFAULT_BATCH=50
NEWSLETTER_SEND_MAX_BATCH=500
NEWSLETTER_SEND_DRY_RUN=false
NEWSLETTER_SEND_WELCOME_ON_SUBSCRIBE=false

# ---------------------------------------------------------------------------
# Demo Request form (POST /api/demo-request)
# ---------------------------------------------------------------------------
DEMO_REQUEST_TO_EMAIL=info@colaberry.com
DEMO_REQUEST_TIMEOUT_MS=8000
DEMO_REQUEST_MAX_MESSAGE=4000

# ---------------------------------------------------------------------------
# Enterprise Accelerator lead ingestion
# Fire-and-forget Step 4 inside /api/demo-request — posts each lead to the
# enterprise leads API in addition to the existing email notification. Failure
# never affects the user-facing response. Toggle ENABLED to dark-launch.
# ---------------------------------------------------------------------------
ENTERPRISE_LEAD_INGEST_URL=https://enterprise.colaberry.ai/api/leads/ingest?source=colaberry&entry=request_demo_form
ENTERPRISE_LEAD_INGEST_TOKEN=
ENTERPRISE_LEAD_INGEST_TIMEOUT_MS=6000
ENTERPRISE_LEAD_INGEST_ENABLED=false

# ---------------------------------------------------------------------------
# Podcast telemetry
# ---------------------------------------------------------------------------
PODCAST_LOG_HASH_SALT=
PODCAST_LOG_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Catalog distribution (cross-platform syndication)
# ---------------------------------------------------------------------------
TWITTER_API_KEY=
TWITTER_ACCESS_TOKEN=
MOLTBOOK_API_TOKEN=

# ---------------------------------------------------------------------------
# Data audit thresholds (CI gate — scripts/audit-data-readiness.mjs)
# ---------------------------------------------------------------------------
AUDIT_MIN_AGENTS=
AUDIT_MIN_MCP=
AUDIT_MIN_PODCASTS=
AUDIT_MIN_USE_CASES=
AUDIT_MIN_RICH_RATIO=
AUDIT_MIN_PODCAST_PLAYABLE_RATIO=
